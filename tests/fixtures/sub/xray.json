   {
    "tag": "dns-out",
    "protocol": "dns",
    "settings": {
     "rules": [
      {
       "qType": "28,64,65",
       "rCode": 5,
       "action": "return"
      },
      {
       "qType": "1",
       "action": "hijack",
       "domain": [
        "geosite:category-ru",
        "geosite:private",
        "regexp:\\.ru$",
        "regexp:\\.su$",
        "regexp:\\.xn--p1ai$"
       ]
      },
      {
       "action": "direct"
      }
     ],
     "rewritePort": 53,
     "rewriteAddress": "8.8.8.8",
     "rewriteNetwork": "udp"
    },
    "streamSettings": {
     "sockopt": {
      "dialerProxy": "proxy"
     }
    }
   },
   {
    "tag": "block",
    "protocol": "blackhole",
    "settings": {
     "response": {
      "type": "http"
     }
    }
   }
  ],
  "routing": {
   "balancers": [
    {
     "tag": "balancer",
     "selector": [
      "proxy-"
     ],
     "strategy": {
      "type": "leastLoad",
      "settings": {
       "maxRTT": "2s",
       "expected": 2,
       "baselines": [
        "2s"
       ],
       "tolerance": 0.05
      }
     },
     "fallbackTag": "proxy"
    }
   ]
  },
  "burstObservatory": {
   "pingConfig": {
    "timeout": "3s",
    "interval": "1m",
    "sampling": 10,
    "destination": "https://connectivitycheck.gstatic.com/generate_204"
   },
   "subjectSelector": [
    "proxy"
   ]
  }
