# ─────────────────────────────────────────────────────────────────────────────
#  rw-monitor — файл конфигурации
#  Обязательны только три параметра в первом блоке. Остальные имеют разумные
#  значения по умолчанию; раскомментируйте строку, чтобы изменить.
#  Параметры, отмеченные [TG], можно менять из Telegram — тогда значение из
#  базы имеет приоритет над этим файлом (и сбрасывается кнопкой в настройках).
# ─────────────────────────────────────────────────────────────────────────────

# ── Обязательные ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Числовой Telegram ID единственного владельца (узнать: @userinfobot)
TELEGRAM_OWNER_ID=
# Ключ шифрования ссылок подписок и учётных данных серверов в базе.
# Генерируется установщиком (или командой: rwmon genkey). Храните копию отдельно:
# без него резервная копия базы бесполезна.
SECRET_KEY=

# ── Сетевые маршруты ─────────────────────────────────────────────────────────
# Прокси ТОЛЬКО для Telegram Bot API: socks5://user:pass@host:port или http://host:port
# Пусто — без прокси. [TG]
TELEGRAM_PROXY_URL=
# Проверки серверов ВСЕГДА идут напрямую с этого сервера; прокси для них не предусмотрен.
# Прокси для запросов к Cheburcheck (обычно не нужен: сервис российский)
#CHEBURCHECK_PROXY_URL=
# Прокси для загрузки подписок (нужен, только если панель недоступна из России напрямую)
#SUBSCRIPTION_PROXY_URL=

# ── Хранилище ────────────────────────────────────────────────────────────────
DATA_DIR=/var/lib/rw-monitor
#DB_PATH=/var/lib/rw-monitor/rwmon.sqlite3
# Сколько ежедневных резервных копий хранить и в котором часу (МСК) их делать
#BACKUP_KEEP=7
#BACKUP_HOUR_MSK=4

# ── Мониторинг ───────────────────────────────────────────────────────────────
# Интервал планового цикла, секунды [TG]
#CHECK_INTERVAL=180
# Сколько неудач подряд нужно для DOWN (минимум 2) [TG]
#FAIL_THRESHOLD=3
# Сколько успехов подряд нужно для восстановления [TG]
#RECOVERY_THRESHOLD=3
# Паузы перед перепроверками после неудачи, секунды; последнее значение повторяется [TG]
#RECHECK_INTERVALS=30,60
# Пауза между проверками восстанавливающегося сервера, секунды [TG]
#RECOVERY_RECHECK_INTERVAL=30
# Период наблюдения после восстановления, секунды [TG]
#RECOVERED_HOLD=600
# Сколько серверов проверять одновременно [TG]
#CHECK_CONCURRENCY=5

# ── Таймауты, секунды [TG] ───────────────────────────────────────────────────
#DNS_TIMEOUT=4
#TCP_TIMEOUT=5
#TLS_TIMEOUT=7
#QUIC_TIMEOUT=3
#E2E_TIMEOUT=12
# Попыток TCP-соединения внутри одной проверки
#TCP_ATTEMPTS=2

# ── DNS и IP ─────────────────────────────────────────────────────────────────
# Независимые резолверы для перепроверки ответа системного DNS
#DNS_RESOLVERS=77.88.8.8,8.8.8.8
# auto — IPv6 проверяется, только если у сервера есть IPv6-связность; ipv4 | ipv6 | both
#IP_FAMILY=auto
#MAX_IPS_PER_SERVER=4

# ── Самоконтроль мониторинга ─────────────────────────────────────────────────
# Контрольные узлы host:port. Группа считается исправной, если отвечает хотя бы один узел.
# Если недоступна вся зарубежная группа — результаты проверок не учитываются.
#CANARY_RU=ya.ru:443,vk.com:443,77.88.8.8:53
#CANARY_FOREIGN=www.google.com:443,github.com:443,www.microsoft.com:443,8.8.8.8:53
#CANARY_DNS_NAME=ya.ru
# Массовый сбой: одновременно отказали не меньше MASS_FAIL_PERCENT % и не меньше MASS_FAIL_MIN серверов
#MASS_FAIL_PERCENT=50
#MASS_FAIL_MIN=3
# Нестабильный сервер: FLAP_MAX_INCIDENTS падений за FLAP_WINDOW секунд
#FLAP_MAX_INCIDENTS=3
#FLAP_WINDOW=3600

# ── Сквозная проверка через Xray-core ────────────────────────────────────────
# on — проверять работу самого туннеля (рекомендуется); off — только DNS → TCP/QUIC → TLS [TG]
#E2E_MODE=on
XRAY_BIN=/opt/rw-monitor/bin/xray
# Адреса, которые запрашиваются через туннель; успех — ответ любого
#E2E_TEST_URLS=https://www.gstatic.com/generate_204,https://cp.cloudflare.com/generate_204
# Как часто загружать тестовый объём через туннель (ловит обрыв после 16–20 КБ); 0 — выключить [TG]
#E2E_DATA_PROBE_EVERY=900
#E2E_DATA_PROBE_URL=https://speed.cloudflare.com/__down?bytes=131072
#E2E_DATA_PROBE_BYTES=131072
#E2E_CONCURRENCY=3

# ── Подписки ─────────────────────────────────────────────────────────────────
#SUBSCRIPTION_USER_AGENT=rw-monitor/1.0
# Автообновление списка серверов, секунды; 0 — выключить [TG]
#SUBSCRIPTION_REFRESH_INTERVAL=3600
#SUBSCRIPTION_TIMEOUT=20
# Идентификатор устройства для панелей с лимитом устройств (HWID).
# Пусто — создаётся один раз при первом разрешении и хранится в базе.
#SUBSCRIPTION_HWID=

# ── Cheburcheck ──────────────────────────────────────────────────────────────
# Запрашивается только по подтверждённому падению или по кнопке [TG]
#CHEBURCHECK_ENABLED=true
#CHEBURCHECK_BASE_URL=https://cheburcheck.ru
# Запрашивать замеры у региональных сканеров (иначе только списки) [TG]
#CHEBURCHECK_PROBE=true
# Сколько секунд ждать данные перед отправкой уведомления о падении [TG]
#CHEBURCHECK_WAIT=40
# Сколько секунд считать полученный результат свежим [TG]
#CHEBURCHECK_CACHE_TTL=3600
# Потолок запросов в сутки [TG]
#CHEBURCHECK_DAILY_LIMIT=300
# Что запрашивать: ip, domain, sni
#CHEBURCHECK_TARGETS=ip,domain,sni

# ── Хранение истории, дни ────────────────────────────────────────────────────
#RETENTION_CHECKS_DAYS=14
#RETENTION_EVENTS_DAYS=180
#RETENTION_CHEBURCHECK_DAYS=90

# ── Прочее ───────────────────────────────────────────────────────────────────
#LOG_LEVEL=INFO
# Необязательный внешний контроль «жив ли сам мониторинг» (например, healthchecks.io):
# адрес запрашивается напрямую раз в HEARTBEAT_INTERVAL секунд, пока мониторинг работает.
#HEARTBEAT_URL=
#HEARTBEAT_INTERVAL=300

# ── Тонкая настройка (обычно менять не нужно) ────────────────────────────────
# Дополнительные форматы подписки, запрашиваемые вместе с основным (для полноты списка серверов)
#SUBSCRIPTION_EXTRA_PROFILES=json,mihomo
# Какими клиентами представляться при первом добавлении, если панель не отдаёт серверы «чужому» клиенту
#SUBSCRIPTION_FALLBACK_USER_AGENTS=Happ/3.13.0,v2rayNG/1.10.31,v2RayTun/5.16.0,INCY/1.4.0,Streisand,clash-verge/v2.4.2
# Минимальные паузы между запросами к Cheburcheck, секунды (лимиты сервиса: 30 и 5 запросов в минуту)
#CHEBURCHECK_CHECK_INTERVAL=3
#CHEBURCHECK_PROBE_INTERVAL=15
# После простоя дольше этого (сек) счётчики неудач и успехов начинаются заново
#STATE_STALE_AFTER=600
# Адрес Bot API (для собственного сервера Bot API)
#TELEGRAM_API_BASE_URL=https://api.telegram.org
